+"""Metrics configuration - defines which indicators to use in signal score.28 available datasets, 13 selected for scoring across 4 groups.
+
+Categories and weights (evidence-based):
+- On-Chain Valuation: 30%  (Dubey 2025, MVRV/SOPR)
+- Derivatives Sentiment: 25% (funding, OI, liquidations)
+- Supply Flow: 25%          (exchange flow, whale ratio, stablecoins)
+- Technical Momentum: 20%  (price returns, MA crossovers)
+"""
+
+from __future__ import annotations
+
+# -- Group 1: On-Chain Valuation (30%) ---------------------------------------
+# MVRV < 1 = undervalued, > 3.5 = overvalued
+# Puell Multiple < 0.5 = miner capitulation, > 4 = cycle top
+# Fund Flow Ratio: high = speculative, low = accumulation
+ONCHAIN_VALUATION = {
+    "btc_mvrv_ratio": {
+        "weight": 0.40,
+        "direction": "higher_worse",  # high MVRV = overvalued
+        "normalization": "percentile",
+        "description": "Market Value to Realized Value ratio",
+    },
+    "btc_puell_multiple": {
+        "weight": 0.30,
+        "direction": "higher_worse",
+        "normalization": "percentile",
+        "description": "Mining revenue relative to 365d average",
+    },
+    "btc_fund_flow_ratio": {
+        "weight": 0.30,
+        "direction": "higher_worse",
+        "normalization": "percentile",
+        "description": "Exchange inflow vs total on-chain volume",
+    },
+}
+ONCHAIN_VALUATION_GROUP_WEIGHT = 0.30
+
+# -- Group 2: Derivatives Sentiment (25%) -------------------------------------
+# Funding > 0.05% = overleveraged longs
+# High OI + rising price = bullish conviction
+# Taker buy/sell > 1 = aggressive buying
+# Liquidations: extreme = capitulation signal
+DERIVATIVES_SENTIMENT = {
+    "btc_funding_rates": {
+        "weight": 0.30,
+        "direction": "higher_worse",
+        "normalization": "percentile",
+        "description": "Perpetual futures funding rate",
+    },
+    "btc_open_interest": {
+        "weight": 0.20,
+        "direction": "neutral",  # used with price context
+        "normalization": "percentile",
+        "description": "Total open interest in USD",
+    },
+    "btc_taker_buy_sell_ratio": {
+        "weight": 0.25,
+        "direction": "lower_worse",  # low = selling pressure
+        "normalization": "percentile",
+        "description": "Taker buy volume / sell volume",
+    },
+    "btc_long_liquidations_usd": {
+        "weight": 0.25,
+        "direction": "higher_worse",  # extreme long liquidations = panic
+        "normalization": "percentile",
+        "description": "Long liquidations in USD",
+    },
+}
+DERIVATIVES_GROUP_WEIGHT = 0.25
+
+# -- Group 3: Supply Flow (25%) ----------------------------------------------
+# Exchange outflow > inflow = accumulation (bullish)
+# Whale ratio: high = whale selling pressure
+# Stablecoin reserve rising = dry powder increasing
+SUPPLY_FLOW = {
+    "btc_exchange_netflow": {
+        "weight": 0.25,
+        "direction": "higher_worse",  # positive netflow = coins moving to exchanges
+        "normalization": "percentile",
+        "description": "Net BTC flow to/from exchanges",
+    },
+    "btc_exchange_whale_ratio": {
+        "weight": 0.25,
+        "direction": "higher_worse",
+        "normalization": "percentile",
+        "description": "Top 10 inflow transactions / total inflow",
+    },
+    "stablecoin_exchange_reserve": {
+        "weight": 0.25,
+        "direction": "lower_worse",  # declining stablecoin reserve = less buying power
+        "normalization": "percentile",
+        "description": "Total stablecoins on exchanges",
+    },
+    "btc_exchange_supply_ratio": {
+        "weight": 0.25,
+        "direction": "higher_worse",  # more BTC on exchanges = selling pressure
+        "normalization": "percentile",
+        "description": "BTC on exchanges / total supply",
+    },
+}
+SUPPLY_FLOW_GROUP_WEIGHT = 0.25
+
+# -- Group 4: Technical Momentum (20%) ----------------------------------------
+# Uses Binance price data - returns and MA crossovers
+TECHNICAL_MOMENTUM = {
+    "return_7d": {
+        "weight": 0.15,
+        "direction": "higher_worse",  # sharp short-term rally = overbought risk
+        "normalization": "percentile",
+        "description": "7-day price return",
+    },
+    "return_30d": {
+        "weight": 0.20,
+        "direction": "higher_worse",
+        "normalization": "percentile",
+        "description": "30-day price return",
+    },
+    "return_90d": {
+        "weight": 0.20,
+        "normalization": "percentile",
+        "direction": "higher_worse",
+        "description": "90-day price return",
+    },
+    "return_365d": {
+        "weight": 0.25,
+        "direction": "neutral",
+        "normalization": "percentile",
+        "description": "365-day price return",
+    },
+    "sma_ratio_30_200": {
+        "weight": 0.20,
+        "direction": "neutral",  # computed in signal_score.py
+        "normalization": "percentile",
+        "description": "SMA30 / SMA200 ratio",
+    },
+}
+TECHNICAL_GROUP_WEIGHT = 0.20
+
+# -- Combined Config ---------------------------------------------------------
+
+ALL_INDICATOR_GROUPS = {
+    "onchain_valuation": {
+        "weight": ONCHAIN_VALUATION_GROUP_WEIGHT,
+        "indicators": ONCHAIN_VALUATION,
+    },
+    "derivatives_sentiment": {
+        "weight": DERIVATIVES_GROUP_WEIGHT,
+        "indicators": DERIVATIVES_SENTIMENT,
+    },
+    "supply_flow": {
+        "weight": SUPPLY_FLOW_GROUP_WEIGHT,
+        "indicators": SUPPLY_FLOW,
+    },
+    "technical_momentum": {
+        "weight": TECHNICAL_GROUP_WEIGHT,
+        "indicators": TECHNICAL_MOMENTUM,
+    },
+}
+
+# Total should be 1.0
+_total_weight = sum(g["weight"] for g in ALL_INDICATOR_GROUPS.values())
+assert abs(_total_weight - 1.0) < 1e-9, f"Group weights sum to {_total_weight}, expected 1.0"
