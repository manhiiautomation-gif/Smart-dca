diff --git a/.github/workflows/compute_score.yml b/.github/workflows/compute_score.yml
new file mode 100644
index 0000000..d348bc4
--- /dev/null
+++ b/.github/workflows/compute_score.yml
@@ -0,0 +1,39 @@
+name: Compute Signal Score
+
+on:
+  schedule:
+    # Run daily at 06:00 UTC (13:00 THB) - after on-chain data updates
+    - cron: '0 6 * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  compute:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+
+      - name: Install dependencies
+        run: pip install -r requirements.txt
+
+      - name: Run Phase 1 + Phase 2 - Compute Signal Score
+        run: python -m src.signal_score
+
+      - name: Commit output
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add output/signal_score.json output/latest_data.json output/historical_scores.csv
+          if git diff --cached --quiet; then
+            echo "No changes to commit"
+          else
+            git commit -m "data: update signal score $(date -u +%Y-%m-%d)"
+            git push
+          fi
