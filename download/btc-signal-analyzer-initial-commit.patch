+"""Phase 2 - Signal Score Computation.
+
+Score 0-100 where:
+  0-25  = Extreme Fear (strong buy zone)
+  25-45 = Fear (accumulate)
+  45-55 = Neutral
+  55-75 = Greed (caution / reduce buys)
+  75-100 = Extreme Greed (sell / halt DCA)
+"""
+from __future__ import annotations
+
+import json
+import logging
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+
+from src.onchain_fetcher import OUTPUT_DIR, fetch_all_data
+from src.metrics_config import ALL_INDICATOR_GROUPS
+
+log = logging.getLogger(__name__)
+
+LOOKBACK_WINDOW = 365  # percentile rolling window in days
+SMA_FAST = 30
+SMA_SLOW = 200
+
+
+# -- Zone thresholds (score 0-100) --
+ZONES = {
+    "extreme_fear":  (0, 25),
+    "fear":          (25, 45),
+    "neutral":       (45, 55),
+    "greed":         (55, 75),
+    "extreme_greed": (75, 100),
+}
+
+
+def get_zone(score: float) -> str:
+    """Map score to zone label."""
+    for zone, (lo, hi) in ZONES.items():
+        if lo <= score < hi:
+            return zone
+    return "extreme_greed" if score >= 100 else "extreme_fear"
+
+
+# -- Step 1: Add Technical Indicators ----------------------------------------
+
+def add_technicals(df: pd.DataFrame) -> pd.DataFrame:
+    """Add SMA30, SMA200, and SMA ratio to unified DataFrame."""
+    result = df.copy()
+    result["sma_30"] = result["close"].rolling(SMA_FAST).mean()
+    result["sma_200"] = result["close"].rolling(SMA_SLOW).mean()
+    result["sma_ratio_30_200"] = result["sma_30"] / result["sma_200"]
+    return result
+
+
+# -- Step 2: Rolling Percentile Normalization --------------------------------
+
+def rolling_percentile(series: pd.Series, window: int = LOOKBACK_WINDOW) -> pd.Series:
+    """Compute rolling percentile rank (0 to 1) over the lookback window.
+
+    For each row, the percentile is: how many values in the past `window`
+    days (including current) were <= the current value, divided by count.
+    This gives 0.0 = lowest in window, 1.0 = highest in window.
+    """
+    def _pct_rank(arr: np.ndarray) -> float:
+        valid = arr[~np.isnan(arr)]
+        n = len(valid)
+        if n < 10:
+            return np.nan
+        current = valid[-1]
+        return np.searchsorted(np.sort(valid), current) / n
+
+    return series.rolling(window=window, min_periods=30).apply(_pct_rank, raw=True)
+
+
+# -- Step 3: Direction Mapping -----------------------------------------------
+
+def map_direction(percentile: float, direction: str) -> float:
+    """Map raw percentile (0-1) to directional risk score (0-1).
+
+    - higher_worse: high value = risky. percentile directly maps.
+      Example: MVRV at 90th pct -> score 0.90
+    - lower_worse: low value = risky. Invert.
+      Example: stablecoin reserve at 10th pct -> score 0.90
+    - neutral: use raw percentile as-is.
+    """
+    if np.isnan(percentile):
+        return np.nan
+    if direction == "higher_worse":
+        return percentile
+    elif direction == "lower_worse":
+        return 1.0 - percentile
+    else:
+        return percentile
+
+
+# -- Step 4: Score Computation ------------------------------------------------
+
+def compute_indicator_scores(df: pd.DataFrame) -> dict[str, pd.Series]:
+    """Compute directional risk score (0-1) for each of the 13 indicators."""
+    scores: dict[str, pd.Series] = {}
+    for group_name, group_cfg in ALL_INDICATOR_GROUPS.items():
+        for ind_name, ind_cfg in group_cfg["indicators"].items():
+            if ind_name not in df.columns:
+                log.warning("Indicator '%s' not in DataFrame, skipping", ind_name)
+                scores[ind_name] = pd.Series(np.nan, index=df.index)
+                continue
+            pct = rolling_percentile(df[ind_name], LOOKBACK_WINDOW)
+            direction = ind_cfg["direction"]
+            scores[ind_name] = pct.apply(lambda x, d=direction: map_direction(x, d))
+    return scores
+
+
+def compute_group_scores(
+    indicator_scores: dict[str, pd.Series],
+) -> dict[str, pd.Series]:
+    """Weighted group scores (0-1) from individual indicator scores."""
+    group_scores: dict[str, pd.Series] = {}
+    for group_name, group_cfg in ALL_INDICATOR_GROUPS.items():
+        indicators = group_cfg["indicators"]
+        total_w = sum(c["weight"] for c in indicators.values())
+        idx = next(iter(indicator_scores.values())).index
+        score = pd.Series(0.0, index=idx)
+        for ind_name, ind_cfg in indicators.items():
+            w = ind_cfg["weight"] / total_w
+            score = score + indicator_scores[ind_name] * w
+        group_scores[group_name] = score
+    return group_scores
+
+
+def compute_final_score(group_scores: dict[str, pd.Series]) -> pd.Series:
+    """Final weighted signal score (0-100) from group scores."""
+    idx = next(iter(group_scores.values())).index
+    final = pd.Series(0.0, index=idx)
+    for gname, gcfg in ALL_INDICATOR_GROUPS.items():
+        final = final + group_scores[gname] * gcfg["weight"]
+    return final * 100.0
+
+
+# -- Output ------------------------------------------------------------------
+
+def build_score_output(
+    df: pd.DataFrame,
+    indicator_scores: dict[str, pd.Series],
+    group_scores: dict[str, pd.Series],
+    final_score: pd.Series,
+) -> dict[str, Any]:
+    """Build the output dict for signal_score.json."""
+    latest_date = df.index[-1]
+    score_now = final_score.iloc[-1]
+
+    # Group breakdown
+    group_breakdown = {}
+    for gname, gscore in group_scores.items():
+        val = gscore.iloc[-1]
+        group_breakdown[gname] = {
+            "score": round(float(val), 4) if not np.isnan(val) else None,
+            "weight": ALL_INDICATOR_GROUPS[gname]["weight"],
+            "contribution": round(float(val * ALL_INDICATOR_GROUPS[gname]["weight"]), 4)
+                if not np.isnan(val) else None,
+        }
+
+    # Indicator breakdown
+    indicator_breakdown = {}
+    for iname, iscore in indicator_scores.items():
+        raw_val = df[iname].iloc[-1] if iname in df.columns else None
+        pct_val = iscore.iloc[-1]
+        direction = "unknown"
+        for gcfg in ALL_INDICATOR_GROUPS.values():
+            if iname in gcfg["indicators"]:
+                direction = gcfg["indicators"][iname]["direction"]
+                break
+        indicator_breakdown[iname] = {
+            "raw_value": round(float(raw_val), 6)
+                if raw_val is not None and not np.isnan(raw_val) else None,
+            "percentile": round(float(pct_val), 4) if not np.isnan(pct_val) else None,
+            "direction": direction,
+        }
+
+    # Historical (last 365 days)
+    n = min(365, len(final_score))
+    start_idx = len(final_score) - n
+    history_scores = [
+        round(float(s), 2) if not np.isnan(s) else None
+        for s in final_score.iloc[start_idx:]
+    ]
+    group_history = {}
+    for gname, gscore in group_scores.items():
+        group_history[gname] = [
+            round(float(v), 4) if not np.isnan(v) else None
+            for v in gscore.iloc[start_idx:]
+        ]
+
+    return {
+        "date": latest_date,
+        "computed_at": datetime.now(timezone.utc).isoformat(),
+        "signal_score": round(float(score_now), 2) if not np.isnan(score_now) else None,
+        "zone": get_zone(score_now) if not np.isnan(score_now) else None,
+        "btc_close": round(float(df["close"].iloc[-1]), 2),
+        "groups": group_breakdown,
+        "indicators": indicator_breakdown,
+        "history": {
+            "dates": df.index[start_idx:].tolist(),
+            "signal_scores": history_scores,
+            "group_scores": group_history,
+        },
+    }
+
+
+# -- Main Entry Point --------------------------------------------------------
+
+def run_signal_score(use_cache: bool = True) -> dict[str, Any]:
+    """Full Phase 2 pipeline: fetch -> compute -> return score output."""
+    start = time.time()
+    log.info("=== Phase 2 Signal Score Start ===")
+
+    data = fetch_all_data(use_cache=use_cache)
+    df = data["unified_df"].copy()
+
+    log.info("Adding technical indicators (SMA30, SMA200)...")
+    df = add_technicals(df)
+
+    log.info("Computing rolling percentiles (%d-day window)...", LOOKBACK_WINDOW)
+    indicator_scores = compute_indicator_scores(df)
+
+    log.info("Computing group scores...")
+    group_scores = compute_group_scores(indicator_scores)
+
+    log.info("Computing final signal score...")
+    final_score = compute_final_score(group_scores)
+
+    output = build_score_output(df, indicator_scores, group_scores, final_score)
+
+    output_file = OUTPUT_DIR / "signal_score.json"
+    with open(output_file, "w") as f:
+        json.dump(output, f, indent=2, default=str)
+    log.info("Saved signal score -> %s", output_file)
+
+    # Export historical CSV for backtest
+    csv_file = OUTPUT_DIR / "historical_scores.csv"
