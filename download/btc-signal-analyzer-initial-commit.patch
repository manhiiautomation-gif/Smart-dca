+"""Phase 1 Data Pipeline - Binance Price + 27 On-Chain/Derivatives Datasets.
+
+Primary price source: Binance BTC/USDT daily klines.
+Secondary sources: crypto-market-data (ErcinDedeoglu, CC BY 4.0).
+Output: unified dict with price OHLCV + 27 on-chain metrics, aligned by date.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import time
+from datetime import datetime, timezone, timedelta
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import requests
+
+
+# -- Config ------------------------------------------------------------------
+
+PROJECT_ROOT = Path(__file__).resolve().parent.parent
+CACHE_DIR = PROJECT_ROOT / "data" / "cache"
+OUTPUT_DIR = PROJECT_ROOT / "output"
+
+CACHE_DIR.mkdir(parents=True, exist_ok=True)
+OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
+
+BINANCE_KLINES_URL = "https://api.binance.com/api/v3/klines"
+CRYPTO_MARKET_DATA_BASE = (
+    "https://raw.githubusercontent.com/ErcinDedeoglu/crypto-market-data/main/data/daily/"
+)
+
+# 27 datasets grouped by category
+ONCHAIN_DATASETS: dict[str, list[str]] = {
+    "exchange_flow": [
+        "btc_exchange_netflow",
+        "btc_exchange_reserve",
+        "btc_exchange_reserve_usd",
+        "btc_exchange_inflow_total",
+        "btc_exchange_outflow_total",
+        "btc_exchange_whale_ratio",
+        "btc_exchange_supply_ratio",
+        "btc_exchange_stablecoins_ratio",
+        "btc_exchange_stablecoins_ratio_usd",
+    ],
+    "derivatives": [
+        "btc_funding_rates",
+        "btc_open_interest",
+        "btc_taker_buy_sell_ratio",
+        "btc_long_liquidations",
+        "btc_long_liquidations_usd",
+        "btc_short_liquidations",
+        "btc_short_liquidations_usd",
+    ],
+    "valuation": [
+        "btc_mvrv_ratio",
+        "btc_coinbase_premium_index",
+        "btc_coinbase_premium_gap",
+        "btc_korea_premium_index",
+        "btc_fund_flow_ratio",
+    ],
+    "miners": [
+        "btc_miners_position_index",
+        "btc_miner_netflow_total",
+        "btc_puell_multiple",
+    ],
+    "stablecoin": [
+        "stablecoin_exchange_reserve",
+        "stablecoin_exchange_netflow",
+        "stablecoin_exchange_inflow_total",
+        "stablecoin_exchange_outflow_total",
+    ],
+}
+
+ALL_DATASETS = [name for names in ONCHAIN_DATASETS.values() for name in names]
+assert len(ALL_DATASETS) == 28, f"Expected 28 datasets, got {len(ALL_DATASETS)}"
+
+log = logging.getLogger(__name__)
+
+
+# -- Utility -----------------------------------------------------------------
+
+def _ts_ms_to_date(ts_ms: int | float) -> str:
+    """Convert millisecond timestamp to 'YYYY-MM-DD' string in UTC."""
+    return (
+        datetime.fromtimestamp(ts_ms / 1000, tz=timezone.utc)
+        .strftime("%Y-%m-%d")
+    )
+
+
+def _date_to_ts_ms(date_str: str) -> int:
+    """Convert 'YYYY-MM-DD' to millisecond timestamp (midnight UTC)."""
+    dt = datetime.strptime(date_str, "%Y-%m-%d").replace(tzinfo=timezone.utc)
+    return int(dt.timestamp() * 1000)
+
+
+def _retry_request(url: str, params: dict | None = None,
+                    max_retries: int = 3, timeout: int = 30) -> requests.Response:
+    """GET with retry + exponential backoff."""
+    for attempt in range(1, max_retries + 1):
+        try:
+            resp = requests.get(url, params=params, timeout=timeout)
+            resp.raise_for_status()
+            return resp
+        except requests.RequestException as e:
+            if attempt == max_retries:
+                raise
+            wait = 2 ** attempt
+            log.warning("Request failed (%s), retry %d/%d in %ds: %s",
+                        url, attempt, max_retries, wait, e)
+            time.sleep(wait)
+    raise RuntimeError("Unreachable")  # pragma: no cover
+
+
+# -- Binance Price -----------------------------------------------------------
+
+def fetch_binance_price(
+    symbol: str = "BTCUSDT",
+    interval: str = "1d",
+    limit: int = 1000,
+    use_cache: bool = True,
+    cache_hours: int = 4,
+) -> pd.DataFrame:
+    """Fetch BTC/USDT daily klines from Binance.
+
+    Columns: date, open, high, low, close, volume, quote_volume,
+    trades, taker_buy_volume, taker_buy_quote_volume.
+
+    Parameters
+    ----------
+    symbol : str
+        Trading pair (default BTCUSDT).
+    interval : str
+        Kline interval (default 1d).
+    limit : int
+        Number of candles (max 1000 per request).
+    use_cache : bool
+        Whether to use local cache.
+    cache_hours : int
+        Cache validity in hours (default 4).
+
+    Returns
+    -------
+    pd.DataFrame
+        Daily OHLCV + metadata, sorted ascending by date.
+    """
+    cache_file = CACHE_DIR / f"binance_{symbol}_{interval}.parquet"
+
+    # Check cache
+    if use_cache and cache_file.exists():
+        cache_age = time.time() - cache_file.stat().st_mtime
+        if cache_age < cache_hours * 3600:
+            log.info("Loading Binance price from cache: %s (age %.1fh)",
+                     cache_file, cache_age / 3600)
+            return pd.read_parquet(cache_file)
+
+    # Fetch from Binance
+    params = {"symbol": symbol, "interval": interval, "limit": limit}
+    log.info("Fetching Binance klines: %s %s x%d", symbol, interval, limit)
+    resp = _retry_request(BINANCE_KLINES_URL, params=params)
+    raw = resp.json()
+    if not raw:
+        raise ValueError("Binance returned empty klines data")
+
+    df = pd.DataFrame(raw, columns=[
+        "open_time", "open", "high", "low", "close",
+        "volume", "close_time", "quote_volume", "trades",
+        "taker_buy_volume", "taker_buy_quote_volume", "ignore",
+    ])
+
+    # Convert types
+    for col in ["open", "high", "low", "close", "volume",
+                 "quote_volume", "taker_buy_volume", "taker_buy_quote_volume"]:
+        df[col] = df[col].astype(float)
+    df["trades"] = df["trades"].astype(int)
+    df["date"] = pd.to_datetime(df["open_time"], unit="ms", utc=True).dt.strftime("%Y-%m-%d")
+
+    # Drop unused cols, sort
+    df = df[[
+        "date", "open", "high", "low", "close",
+        "volume", "quote_volume", "trades",
+        "taker_buy_volume", "taker_buy_quote_volume",
+    ]].sort_values("date").reset_index(drop=True)
+
+    # Save cache
+    df.to_parquet(cache_file, index=False)
+    log.info("Saved Binance price cache: %d rows (%s -> %s)",
+             len(df), df["date"].iloc[0], df["date"].iloc[-1])
+
+    return df
+
+
+# -- Crypto-Market-Data Fetcher -----------------------------------------------
+
+def fetch_single_dataset(
+    name: str,
+    use_cache: bool = True,
+    cache_hours: int = 12,
+) -> dict[str, Any]:
+    """Fetch a single dataset from crypto-market-data GitHub repo.
+    Returns the raw JSON payload (metadata + data array).
+    """
+    cache_file = CACHE_DIR / f"{name}.json"
+
+    if use_cache and cache_file.exists():
+        cache_age = time.time() - cache_file.stat().st_mtime
+        if cache_age < cache_hours * 3600:
+            log.debug("Cache hit: %s (age %.1fh)", name, cache_age / 3600)
+            with open(cache_file, "r") as f:
+                return json.load(f)
+
+    url = f"{CRYPTO_MARKET_DATA_BASE}{name}.json"
+    log.info("Fetching: %s", url)
+    resp = _retry_request(url)
+    data = resp.json()
+
+    # Validate structure
+    if "data" not in data:
+        raise ValueError(f"Invalid dataset format for {name}: missing 'data' key")
+
+    # Save cache
+    with open(cache_file, "w") as f:
+        json.dump(data, f)
+
+    return data
+
+
+def parse_dataset_to_series(raw: dict[str, Any]) -> pd.Series:
+    """Parse a raw dataset JSON into a pd.Series indexed by date string.
+
+    Converts millisecond timestamps to 'YYYY-MM-DD' strings (UTC).
+    """
+    records = raw.get("data", [])
+    if not records:
+        return pd.Series(dtype=float, name=raw.get("name", "unknown"))
+
+    # Handle both old format ("date") and new format ("timestamp")
+    date_key = "date" if records[0].get("date") is not None else "timestamp"
+    dates = [_ts_ms_to_date(r[date_key]) for r in records]
+    values = [r["value"] for r in records]
+
+    series = pd.Series(values, index=dates, name=raw.get("name", "unknown"))
+    series.index.name = "date"
+
+    # Remove duplicate dates (keep last)
+    series = series[~series.index.duplicated(keep="last")]
+    # Sort ascending
+    series = series.sort_index()
+
+    return series
+
+
+def fetch_all_onchain_datasets(
+    use_cache: bool = True,
+    cache_hours: int = 12,
+) -> dict[str, pd.Series]:
+    """Fetch and parse all 27 on-chain/derivatives datasets.
+
+    Returns
+    -------
+    dict[str, pd.Series]
+        Keys are dataset names, values are date-indexed Series.
+    """
+    result: dict[str, pd.Series] = {}
+
+    for name in ALL_DATASETS:
+        try:
+            raw = fetch_single_dataset(name, use_cache=use_cache,
+                                        cache_hours=cache_hours)
+            series = parse_dataset_to_series(raw)
+            result[name] = series
+            log.info("  OK %s: %d points (%s -> %s)",
+                     name, len(series),
+                     series.index[0] if len(series) else "N/A",
+                     series.index[-1] if len(series) else "N/A")
+        except Exception as e:
+            log.error("  FAIL %s: %s", name, e)
+            # Insert empty series so downstream code does not break
+            result[name] = pd.Series(dtype=float, name=name)
+            result[name].index.name = "date"
+
+    return result
+
+
+# -- Unification -------------------------------------------------------------
+
+def build_unified_dataframe(
+    price_df: pd.DataFrame,
+    metrics: dict[str, pd.Series],
+) -> pd.DataFrame:
+    """Merge price OHLCV with all on-chain metrics into a single DataFrame.
+
+    Left-join on date, aligned to Binance daily dates.
+    Metrics are forward-filled by 1 day max (today's on-chain data
+    may arrive a few hours after the kline close).
+
+    Parameters
+    ----------
+    price_df : pd.DataFrame
+        From fetch_binance_price().
+    metrics : dict[str, pd.Series]
+        From fetch_all_onchain_datasets().
+
+    Returns
+    -------
+    pd.DataFrame
+        Unified DataFrame with all columns.
+    """
+    df = price_df.set_index("date").copy()
+
+    for name, series in metrics.items():
+        if len(series) == 0:
+            df[name] = np.nan
+            continue
+        # Align: forward-fill 1 day to handle same-day delay
+        aligned = series.reindex(df.index, method="ffill", limit=1)
+        df[name] = aligned
+
+    return df
+
+
+def compute_returns(df: pd.DataFrame,
+                    periods: list[int] | None = None) -> pd.DataFrame:
+    """Add price return columns to the unified DataFrame.
+
+    Parameters
+    ----------
+    df : pd.DataFrame
+        Must have 'close' column.
+    periods : list[int]
+        Return windows in days. Default [1, 7, 30, 90, 365].
+
+    Returns
+    -------
+    pd.DataFrame
+        Same df with added 'return_Nd' columns.
+    """
+    if periods is None:
+        periods = [1, 7, 30, 90, 365]
+
+    result = df.copy()
+    for p in periods:
+        col = f"return_{p}d"
+        result[col] = result["close"].pct_change(p)
+
+    return result
+
+
+# -- Main Entry Point ---------------------------------------------------------
+
+def fetch_all_data(
+    use_cache: bool = True,
+    binance_cache_hours: int = 4,
+    onchain_cache_hours: int = 12,
+) -> dict[str, Any]:
+    """One-call entry point: fetch everything, return unified data + metadata.
+
+    Returns
+    -------
+    dict with keys:
+        - "unified_df": pd.DataFrame (price + all 27 metrics + returns, date-indexed)
+        - "price_df": pd.DataFrame (raw Binance OHLCV)
+        - "metrics": dict[str, pd.Series] (individual on-chain series)
+        - "metadata": dict (fetch timestamps, data quality info)
+        - "latest": dict (latest values snapshot for most recent date)
+    """
+    fetch_start = time.time()
+    log.info("=== Phase 1 Data Pipeline Start ===")
+
+    # 1) Binance Price (PRIMARY)
+    log.info("[1/3] Fetching Binance BTC/USDT price...")
+    price_df = fetch_binance_price(use_cache=use_cache,
+                                   cache_hours=binance_cache_hours)
+
+    # 2) On-Chain / Derivatives (27 datasets)
+    log.info("[2/3] Fetching 27 on-chain/derivatives datasets...")
+    metrics = fetch_all_onchain_datasets(use_cache=use_cache,
+                                        cache_hours=onchain_cache_hours)
+
+    # 3) Unify
+    log.info("[3/3] Building unified DataFrame...")
+    unified = build_unified_dataframe(price_df, metrics)
+    unified = compute_returns(unified)
+
+    # Metadata
+    non_empty = sum(1 for s in metrics.values() if len(s) > 0)
+    fetch_seconds = time.time() - fetch_start
+
+    metadata = {
+        "fetched_at": datetime.now(timezone.utc).isoformat(),
+        "fetch_duration_sec": round(fetch_seconds, 2),
+        "price_rows": len(price_df),
+        "price_range": [price_df["date"].iloc[0], price_df["date"].iloc[-1]],
+        "onchain_datasets_total": len(metrics),
+        "onchain_datasets_nonempty": non_empty,
+        "unified_rows": len(unified),
+        "unified_columns": list(unified.columns),
+    }
+
+    # Latest snapshot (last row)
+    latest_date = unified.index[-1]
+    latest_row = unified.iloc[-1]
+    latest = {"date": latest_date}
+    for col in unified.columns:
+        val = latest_row[col]
+        if pd.isna(val):
+            latest[col] = None
+        elif isinstance(val, (np.floating, float)):
+            latest[col] = round(float(val), 6)
+        else:
+            latest[col] = val
+
+    log.info(
+        "=== Pipeline Complete: %d rows x %d cols (%.1fs) ===",
+        len(unified), len(unified.columns), fetch_seconds,
+    )
+
+    return {
+        "unified_df": unified,
+        "price_df": price_df,
+        "metrics": metrics,
+        "metadata": metadata,
+        "latest": latest,
+    }
+
+
+# -- CLI ----------------------------------------------------------------------
+
+if __name__ == "__main__":
+    logging.basicConfig(
+        level=logging.INFO,
+        format="%(asctime)s [%(levelname)s] %(message)s",
+        datefmt="%H:%M:%S",
+    )
+
+    data = fetch_all_data()
+
+    # Print summary
+    print()
+    print("=" * 60)
+    print("PIPELINE SUMMARY")
+    print("=" * 60)
+    meta = data["metadata"]
+    print(f"  Fetched at:     {meta['fetched_at']}")
+    print(f"  Duration:       {meta['fetch_duration_sec']}s")
+    print(f"  Price rows:     {meta['price_rows']} ({meta['price_range'][0]} -> {meta['price_range'][1]})")
+    print(f"  On-chain data:  {meta['onchain_datasets_nonempty']}/{meta['onchain_datasets_total']} datasets")
+    print(f"  Unified table:  {meta['unified_rows']} rows x {len(meta['unified_columns'])} cols")
+
+    # Latest price
+    latest = data["latest"]
+    print()
+    print(f"  Latest date:    {latest['date']}")
+    btc_close = latest.get('close')
+    if btc_close is not None:
+        print(f"  BTC Close:      ${btc_close:,.2f}")
+    vol = latest.get('volume')
+    if vol is not None:
+        print(f"  24h Volume:     {vol:,.0f} BTC")
+
+    # On-chain snapshot
+    print()
+    print("  ON-CHAIN METRICS (latest):")
+    for name in ALL_DATASETS:
+        val = latest.get(name)
+        if val is not None:
+            print(f"    {name:45s} = {val}")
+        else:
+            print(f"    {name:45s} = N/A")
+
+    # Save latest to JSON
+    output_file = OUTPUT_DIR / "latest_data.json"
+    with open(output_file, "w") as f:
+        json.dump(data["latest"], f, indent=2, default=str)
+    print(f"\n  Saved latest snapshot -> {output_file}")
+
+    # Data quality report
+    unified = data["unified_df"]
+    print()
+    print("  DATA QUALITY:")
+    for col in ALL_DATASETS:
+        non_null = unified[col].notna().sum()
+        pct = non_null / len(unified) * 100
+        status = "OK" if pct > 80 else ("WARN" if pct > 50 else "LOW")
+        print(f"    {col:45s} {non_null:5d}/{len(unified)} ({pct:5.1f}%) [{status}]")
