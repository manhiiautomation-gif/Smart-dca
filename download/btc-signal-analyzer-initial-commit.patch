+"""Phase 3 - Walk-Forward Backtest.
+
+4 strategies tested with walk-forward validation (8 folds):
+1. Baseline DCA      - Buy fixed amount every day, no signal
+2. Gated DCA         - Buy only when signal_score < threshold
+3. Score-Weighted DCA - Buy amount inversely proportional to score
+4. Zone DCA          - Buy more in fear zones, skip in greed zones
+
+Metrics per fold: total return, max drawdown, Sharpe ratio,
+                   avg entry price, BTC accumulated.
+"""
+from __future__ import annotations
+
+import json
+import logging
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+
+from src.onchain_fetcher import OUTPUT_DIR
+from src.signal_score import get_zone
+
+log = logging.getLogger(__name__)
+
+# -- Config ------------------------------------------------------------------
+
+DAILY_BUDGET_USD = 100.0       # Fixed daily buy amount (USD)
+FOLD_TEST_DAYS = 75            # ~2.5 months per test fold
+MIN_TRAIN_DAYS = 200           # Minimum days before first fold
+
+# Strategy thresholds (can be optimized per fold)
+GATED_THRESHOLD = 55.0         # Skip buys above this score
+ZONE_SKIP_THRESHOLD = 60.0     # Zone DCA: skip above this
+
+
+def load_historical_scores() -> pd.DataFrame:
+    """Load historical_scores.csv from Phase 2 output."""
+    csv_path = OUTPUT_DIR / "historical_scores.csv"
+    if not csv_path.exists():
+        raise FileNotFoundError(
+            f"{csv_path} not found. Run Phase 2 first: python -m src.signal_score"
+        )
+    df = pd.read_csv(csv_path, parse_dates=["date"])
+    return df
+
+
+# -- Strategy Simulators ------------------------------------------------------
+
+def sim_baseline_dca(df: pd.DataFrame, budget: float = DAILY_BUDGET_USD) -> dict:
+    """Strategy 1: Buy fixed USD every day regardless of score."""
+    valid = df.dropna(subset=["close"]).copy()
+    n = len(valid)
+    btc_bought = (budget / valid["close"]).sum()
+    total_spent = budget * n
+    avg_price = total_spent / btc_bought if btc_bought > 0 else 0
+    final_value = btc_bought * valid["close"].iloc[-1]
+    total_return = (final_value - total_spent) / total_spent
+
+    # Daily portfolio value for drawdown
+    daily_btc = (budget / valid["close"]).cumsum()
+    daily_value = daily_btc * valid["close"]
+    daily_spent = pd.Series(np.arange(1, n + 1) * budget, index=valid.index)
+    daily_pnl = daily_value - daily_spent
+
+    return {
+        "strategy": "baseline_dca",
+        "total_spent": round(total_spent, 2),
+        "btc_accumulated": round(btc_bought, 8),
+        "avg_entry_price": round(avg_price, 2),
+        "final_value": round(final_value, 2),
+        "total_return_pct": round(total_return * 100, 2),
+        "daily_value": daily_value,
+        "daily_spent": daily_spent,
+        "buy_days": n,
+        "skip_days": 0,
+    }
+
+
+def sim_gated_dca(df: pd.DataFrame, threshold: float = GATED_THRESHOLD,
+                  budget: float = DAILY_BUDGET_USD) -> dict:
+    """Strategy 2: Buy only when score < threshold."""
+    valid = df.dropna(subset=["close", "signal_score"]).copy()
+    buy_mask = valid["signal_score"] < threshold
+    buy_days = valid[buy_mask]
+    skip_days = valid[~buy_mask]
+    n_buy = len(buy_days)
+
+    if n_buy == 0:
+        return {
+            "strategy": f"gated_dca_{threshold:.0f}",
+            "total_spent": 0, "btc_accumulated": 0,
+            "avg_entry_price": 0, "final_value": 0,
+            "total_return_pct": 0, "daily_value": pd.Series(dtype=float),
+            "daily_spent": pd.Series(dtype=float),
+            "buy_days": 0, "skip_days": len(skip_days),
+        }
+
+    btc_bought = (budget / buy_days["close"]).sum()
+    total_spent = budget * n_buy
+    avg_price = total_spent / btc_bought if btc_bought > 0 else 0
+    final_value = btc_bought * valid["close"].iloc[-1]
+    total_return = (final_value - total_spent) / total_spent
+
+    # Daily portfolio tracking
+    daily_btc = pd.Series(0.0, index=valid.index)
+    daily_spent = pd.Series(0.0, index=valid.index)
+    for i, row in valid.iterrows():
+        if row["signal_score"] < threshold:
+            daily_btc.loc[i] = budget / row["close"]
+            daily_spent.loc[i] = budget
+    cumul_btc = daily_btc.cumsum()
+    daily_value = cumul_btc * valid["close"]
+    cumul_spent = daily_spent.cumsum()
+
+    return {
+        "strategy": f"gated_dca_{threshold:.0f}",
+        "total_spent": round(total_spent, 2),
+        "btc_accumulated": round(btc_bought, 8),
+        "avg_entry_price": round(avg_price, 2),
+        "final_value": round(final_value, 2),
+        "total_return_pct": round(total_return * 100, 2),
+        "daily_value": daily_value,
+        "daily_spent": cumul_spent,
+        "buy_days": n_buy,
+        "skip_days": len(skip_days),
+    }
+
+
+def sim_score_weighted_dca(df: pd.DataFrame,
+                            budget: float = DAILY_BUDGET_USD) -> dict:
+    """Strategy 3: Buy amount = budget * (1 - score/100).
+
+    Score 0 -> buy $100, Score 50 -> buy $50, Score 100 -> buy $0.
+    """
+    valid = df.dropna(subset=["close", "signal_score"]).copy()
+    weights = 1.0 - (valid["signal_score"] / 100.0)
+    weights = weights.clip(lower=0.05)  # minimum 5% buy even at high scores
+    amounts = budget * weights
+
+    btc_bought = (amounts / valid["close"]).sum()
+    total_spent = amounts.sum()
+    avg_price = total_spent / btc_bought if btc_bought > 0 else 0
+    final_value = btc_bought * valid["close"].iloc[-1]
+    total_return = (final_value - total_spent) / total_spent
+
+    daily_btc = (amounts / valid["close"]).cumsum()
+    daily_value = daily_btc * valid["close"]
+    cumul_spent = amounts.cumsum()
+
+    return {
+        "strategy": "score_weighted_dca",
+        "total_spent": round(total_spent, 2),
+        "btc_accumulated": round(btc_bought, 8),
+        "avg_entry_price": round(avg_price, 2),
+        "final_value": round(final_value, 2),
+        "total_return_pct": round(total_return * 100, 2),
+        "daily_value": daily_value,
+        "daily_spent": cumul_spent,
+        "buy_days": len(valid),
+        "skip_days": 0,
+    }
+
+
+def sim_zone_dca(df: pd.DataFrame,
+                 skip_threshold: float = ZONE_SKIP_THRESHOLD,
+                 budget: float = DAILY_BUDGET_USD) -> dict:
+    """Strategy 4: Multiplier based on zone.
+
+    extreme_fear: 2.0x budget
+    fear:         1.5x budget
+    neutral:      1.0x budget
+    greed:        0.5x budget
+    extreme_greed: 0x (skip)
+    """
+    valid = df.dropna(subset=["close", "signal_score"]).copy()
+
+    ZONE_MULTIPLIERS = {
+        "extreme_fear": 2.0,
+        "fear": 1.5,
+        "neutral": 1.0,
+        "greed": 0.5,
+        "extreme_greed": 0.0,
+    }
+
+    multipliers = valid["signal_score"].apply(
+        lambda s: ZONE_MULTIPLIERS.get(get_zone(s), 1.0)
+    )
+    # Skip if score above threshold regardless of zone
+    multipliers[valid["signal_score"] >= skip_threshold] = 0.0
+    amounts = budget * multipliers
+
+    buy_mask = amounts > 0
+    btc_bought = (amounts[buy_mask] / valid.loc[buy_mask, "close"]).sum()
+    total_spent = amounts.sum()
+    avg_price = total_spent / btc_bought if btc_bought > 0 else 0
+    final_value = btc_bought * valid["close"].iloc[-1]
+    total_return = (final_value - total_spent) / total_spent if total_spent > 0 else 0
+
+    daily_btc = pd.Series(0.0, index=valid.index)
+    for i, row in valid.iterrows():
+        m = ZONE_MULTIPLIERS.get(get_zone(row["signal_score"]), 1.0)
+        if row["signal_score"] >= skip_threshold:
+            m = 0.0
+        amt = budget * m
+        daily_btc.loc[i] = amt / row["close"]
+    cumul_btc = daily_btc.cumsum()
+    daily_value = cumul_btc * valid["close"]
+    cumul_spent = (budget * multipliers).cumsum()
+
+    return {
+        "strategy": f"zone_dca_skip{skip_threshold:.0f}",
+        "total_spent": round(total_spent, 2),
+        "btc_accumulated": round(btc_bought, 8),
+        "avg_entry_price": round(avg_price, 2),
+        "final_value": round(final_value, 2),
+        "total_return_pct": round(total_return * 100, 2),
+        "daily_value": daily_value,
+        "daily_spent": cumul_spent,
+        "buy_days": int(buy_mask.sum()),
+        "skip_days": int((~buy_mask).sum()),
+    }
+
+
+# -- Metrics ------------------------------------------------------------------
+
+def compute_metrics(result: dict, df_test: pd.DataFrame) -> dict[str, float]:
+    """Compute risk metrics from a strategy result."""
+    daily_val = result["daily_value"]
+    daily_spent = result["daily_spent"]
+
+    if len(daily_val) == 0 or daily_val.sum() == 0:
+        return {k: None for k in [
+            "total_return_pct", "max_drawdown_pct", "sharpe_ratio",
+            "avg_entry_price", "btc_accumulated", "buy_ratio",
+        ]}
+
+    # Daily returns (from portfolio value change)
+    daily_net = daily_val - daily_spent
+    daily_returns = daily_net.diff() / daily_spent.replace(0, np.nan)
+    daily_returns = daily_returns.dropna()
+
+    # Max drawdown
+    cumul_net = daily_net.cumsum()
+    running_max = cumul_net.cummax()
+    drawdown = (cumul_net - running_max) / running_max.replace(0, np.nan)
+    max_dd = drawdown.min()
+
+    # Sharpe (annualized, risk-free = 0)
+    if len(daily_returns) > 1 and daily_returns.std() > 0:
+        sharpe = daily_returns.mean() / daily_returns.std() * np.sqrt(365)
+    else:
+        sharpe = 0.0
+
+    total_days = len(df_test.dropna(subset=["close"]))
+    buy_ratio = result["buy_days"] / total_days if total_days > 0 else 0
+
+    return {
+        "total_return_pct": round(result["total_return_pct"], 2),
+        "max_drawdown_pct": round(max_dd * 100, 2) if not np.isnan(max_dd) else None,
+        "sharpe_ratio": round(float(sharpe), 3),
+        "avg_entry_price": result["avg_entry_price"],
+        "btc_accumulated": result["btc_accumulated"],
+        "buy_ratio": round(buy_ratio, 3),
+    }
+
+
+# -- Walk-Forward Engine ------------------------------------------------------
+
+def run_walk_forward(df: pd.DataFrame, n_folds: int = 8) -> dict[str, Any]:
+    """Run walk-forward backtest with n_folds.
+
+    Each fold uses FOLD_TEST_DAYS as test window.
+    Training data = all data before the test window.
+    """
+    scored = df.dropna(subset=["signal_score"]).copy()
+    scored = scored.reset_index(drop=True)
+    total = len(scored)
+
+    # Calculate fold boundaries
+    test_size = min(FOLD_TEST_DAYS, total // (n_folds + 1))
+    start_offset = max(MIN_TRAIN_DAYS, total - n_folds * test_size)
+
+    folds = []
+    strategies = ["baseline_dca", "gated_dca", "score_weighted_dca", "zone_dca"]
+    all_results: dict[str, list[dict]] = {s: [] for s in strategies}
+
+    for fold_i in range(n_folds):
+        test_start = start_offset + fold_i * test_size
+        test_end = min(test_start + test_size, total)
+
+        if test_end >= total or test_end - test_start < 30:
+            log.info("Fold %d: too few days, skipping", fold_i + 1)
+            break
+
+        train_df = scored.iloc[:test_start]
+        test_df = scored.iloc[test_start:test_end]
+
+        fold_info = {
+            "fold": fold_i + 1,
+            "train_range": [train_df["date"].iloc[0] if len(train_df) else None,
+                           train_df["date"].iloc[-1] if len(train_df) else None],
+            "test_range": [str(test_df["date"].iloc[0]),
+                          str(test_df["date"].iloc[-1])],
+            "test_days": len(test_df),
+        }
+        folds.append(fold_info)
+
+        log.info("Fold %d/%d: test %s -> %s (%d days)",
+                 fold_i + 1, n_folds,
+                 fold_info["test_range"][0],
+                 fold_info["test_range"][1],
+                 len(test_df))
+
+        # Optimize gated threshold on training data
+        if len(train_df) > 100:
+            best_thresh, best_ret = 55.0, -999
+            for t in [40, 45, 50, 55, 60, 65]:
+                r = sim_gated_dca(train_df, threshold=t)
+                if r["total_return_pct"] > best_ret:
+                    best_ret = r["total_return_pct"]
+                    best_thresh = t
+        else:
+            best_thresh = 55.0
+
+        # Run strategies on test data
+        results = {
+            "baseline_dca": sim_baseline_dca(test_df),
+            "gated_dca": sim_gated_dca(test_df, threshold=best_thresh),
+            "score_weighted_dca": sim_score_weighted_dca(test_df),
+            "zone_dca": sim_zone_dca(test_df),
+        }
+
+        for sname, sresult in results.items():
+            metrics = compute_metrics(sresult, test_df)
+            metrics["fold"] = fold_i + 1
+            metrics["test_start"] = str(test_df["date"].iloc[0])
+            metrics["test_end"] = str(test_df["date"].iloc[-1])
+            metrics["optimized_threshold"] = best_thresh if sname == "gated_dca" else None
+            all_results[sname].append(metrics)
+
+    return {"folds": folds, "strategy_results": all_results}
+
+
+# -- Full Backtest (non-walk-forward, for reference) --------------------------
+
+def run_full_backtest(df: pd.DataFrame) -> dict[str, Any]:
+    """Run all strategies on full available data."""
+    scored = df.dropna(subset=["signal_score"])
+    log.info("Full backtest: %d days with scores (%s -> %s)",
+             len(scored), scored["date"].iloc[0], scored["date"].iloc[-1])
+
+    results = {
+        "baseline_dca": sim_baseline_dca(scored),
+        "gated_dca": sim_gated_dca(scored),
+        "score_weighted_dca": sim_score_weighted_dca(scored),
+        "zone_dca": sim_zone_dca(scored),
+    }
+
+    summary = {}
+    for sname, sresult in results.items():
+        m = compute_metrics(sresult, scored)
+        m["strategy"] = sname
+        m["total_spent"] = sresult["total_spent"]
+        m["final_value"] = sresult["final_value"]
+        m["buy_days"] = sresult["buy_days"]
+        m["skip_days"] = sresult["skip_days"]
+        summary[sname] = m
+
+    return {
+        "period": [str(scored["date"].iloc[0]), str(scored["date"].iloc[-1])],
+        "total_days": len(scored),
+        "daily_budget_usd": DAILY_BUDGET_USD,
+        "strategies": summary,
+    }
+
+
+# -- Aggregation & Output ----------------------------------------------------
+
+def aggregate_walk_forward(wf_results: dict) -> dict[str, Any]:
+    """Aggregate walk-forward fold results into per-strategy averages."""
+    agg = {}
+    for sname, folds in wf_results["strategy_results"].items():
+        if not folds:
+            agg[sname] = {"error": "no valid folds"}
+            continue
+        df_folds = pd.DataFrame(folds)
+        agg[sname] = {
+            "avg_return_pct": round(df_folds["total_return_pct"].mean(), 2),
+            "std_return_pct": round(df_folds["total_return_pct"].std(), 2),
+            "best_fold_return_pct": round(df_folds["total_return_pct"].max(), 2),
+            "worst_fold_return_pct": round(df_folds["total_return_pct"].min(), 2),
+            "wins": int((df_folds["total_return_pct"] > 0).sum()),
+            "losses": int((df_folds["total_return_pct"] <= 0).sum()),
+            "avg_sharpe": round(df_folds["sharpe_ratio"].mean(), 3),
+            "avg_max_drawdown_pct": round(
+                df_folds["max_drawdown_pct"].dropna().mean(), 2
+            ),
+            "avg_buy_ratio": round(df_folds["buy_ratio"].mean(), 3),
+            "folds_tested": len(folds),
+        }
+    return agg
+
+
+def build_backtest_output(
+    full: dict, wf: dict, wf_agg: dict,
+) -> dict[str, Any]:
+    """Build final output dict for backtest_results.json."""
+    # Find best strategy by walk-forward avg return
+    best_strategy = max(
+        wf_agg.items(),
+        key=lambda x: x[1].get("avg_return_pct", -999) if isinstance(x[1], dict) else -999,
+    )
+
+    return {
+        "computed_at": datetime.now(timezone.utc).isoformat(),
+        "full_backtest": full,
+        "walk_forward": {
+            "folds": wf["folds"],
+            "per_fold_results": wf["strategy_results"],
+            "aggregated": wf_agg,
+            "best_strategy": best_strategy[0],
+            "best_avg_return_pct": best_strategy[1].get("avg_return_pct"),
+        },
+    }
+
+
+# -- Main Entry Point --------------------------------------------------------
+
+def run_backtest() -> dict[str, Any]:
+    """Full Phase 3 pipeline."""
+    start = time.time()
+    log.info("=== Phase 3 Backtest Start ===")
+
+    df = load_historical_scores()
+
+    # Full backtest
+    log.info("Running full backtest...")
+    full = run_full_backtest(df)
+
+    # Walk-forward
+    log.info("Running walk-forward backtest (8 folds)...")
+    wf = run_walk_forward(df, n_folds=8)
+    wf_agg = aggregate_walk_forward(wf)
+
+    output = build_backtest_output(full, wf, wf_agg)
+
+    output_file = OUTPUT_DIR / "backtest_results.json"
+    with open(output_file, "w") as f:
+        json.dump(output, f, indent=2, default=str)
+    log.info("Saved backtest results -> %s", output_file)
+    log.info("=== Phase 3 Complete (%.1fs) ===", time.time() - start)
+
+    return output
+
+
+# -- CLI ----------------------------------------------------------------------
+
+if __name__ == "__main__":
+    import time
+
+    logging.basicConfig(
+        level=logging.INFO,
+        format="%(asctime)s [%(levelname)s] %(message)s",
+        datefmt="%H:%M:%S",
+    )
+
+    output = run_backtest()
+
+    print()
+    print("=" * 65)
+    print("BACKTEST RESULTS")
+    print("=" * 65)
+
+    # Full backtest summary
+    full = output["full_backtest"]
+    print(f"\n  Period: {full['period'][0]} -> {full['period'][1]} ({full['total_days']} days)")
+    print(f"  Daily budget: ${full['daily_budget_usd']}")
+    print()
+    print(f"  {'Strategy':<25s} {'Return':>8s} {'Entry$':>8s} {'BTC':>10s} {'Buy':>5s} {'Skip':>5s}")
+    print(f"  {'-'*25} {'-'*8} {'-'*8} {'-'*10} {'-'*5} {'-'*5}")
+    for sname, sdata in full["strategies"].items():
+        ret = sdata["total_return_pct"]
+        entry = sdata["avg_entry_price"]
+        btc = sdata["btc_accumulated"]
+        buy = sdata["buy_days"]
+        skip = sdata["skip_days"]
+        print(f"  {sname:<25s} {ret:>+7.2f}% ${entry:>7,.0f} {btc:>10.6f} {buy:>4d} {skip:>4d}")
+
+    # Walk-forward
+    wf = output["walk_forward"]
+    print(f"\n  WALK-FORWARD VALIDATION ({wf['aggregated'].get('baseline_dca', {}).get('folds_tested', '?')} folds)")
+    print(f"  {'Strategy':<25s} {'Avg Ret':>8s} {'Std':>7s} {'Sharpe':>7s} {'W/L':>5s} {'Buy%':>6s}")
+    print(f"  {'-'*25} {'-'*8} {'-'*7} {'-'*7} {'-'*5} {'-'*6}")
+    for sname, sdata in wf["aggregated"].items():
+        if "error" in sdata:
+            print(f"  {sname:<25s} ERROR")
+            continue
+        avg_r = sdata["avg_return_pct"]
+        std_r = sdata["std_return_pct"]
+        sharpe = sdata["avg_sharpe"]
+        wl = f"{sdata['wins']}/{sdata['losses']}"
+        buy_pct = sdata["avg_buy_ratio"] * 100
+        print(f"  {sname:<25s} {avg_r:>+7.2f}% {std_r:>6.2f} {sharpe:>+6.3f} {wl:>5s} {buy_pct:>5.1f}%")
+
+    print(f"\n  Best WF strategy: {wf['best_strategy']} (avg {wf['best_avg_return_pct']:+.2f}%)")
